#!name = GLaDOS 签到
#!desc = GLaDOS 多账号每日签到 (cron + 手动入口); Cookie 池用 & 分隔, 账号可加 domain@ 前缀指定主站, 其余粘贴浏览器完整 Cookie
#!author = noxenys
#!homepage = https://github.com/noxenys/loon
#!icon = https://raw.githubusercontent.com/noxenys/loon/main/glados/icon.png
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.5.1(983)
#!date = 2026-10-13
#!tag = 签到,GLaDOS
#!type = normal

[Argument]
cookies = input,"",tag=Cookie 池,desc=多账号用 & 分隔; 每个账号=完整 Cookie(必含 koa:sess 与 koa:sess.sig); 可选 域名@ 前缀, 默认 glados.rocks
notify = switch,true,tag=推送签到结果
delay = input,3,type=number,tag=账号间隔(秒),desc=防风控, 建议 >=3
force = switch,false,tag=忽略今日已签记录,desc=开启后每次运行都重新签到
ua = input,"",tag=自定义 UA(可选),desc=默认 Windows Chrome; 需与领 Cookie 时的登录设备一致, 否则风控 device-mismatch

[Script]
cron "0 30 7,21 * * *" then script("https://raw.githubusercontent.com/noxenys/loon/main/glados/glados.js", {${cookies}, ${notify}, ${delay}, ${force}, ${ua}}) with tag="GLaDOS 每日签到", timeout=600, enable=true
generic then script("https://raw.githubusercontent.com/noxenys/loon/main/glados/glados.js", {${cookies}, ${notify}, ${delay}, ${force}, ${ua}}) with tag="GLaDOS 手动签到", img_url="checkmark.seal", timeout=600
